{
  "name": "lol-friends-tracker",
  "version": "1.0.0",
  "description": "La Grieta de los Pibes — Tracker de League of Legends con ranking, desempeño estilo OP.GG y análisis competitivo para amigos.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "refresh": "node report.js --refresh",
    "sync:opgg": "node scripts/sync-opgg.js",
    "rescore": "node scripts/recompute.js",
    "report": "node report.js",
    "demo": "node src/demo.js && node server.js",
    "build": "node build.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "node --test test/e2e/site.e2e.js"
  },
  "devDependencies": {
    "puppeteer": "24.38.0"
  }
}
